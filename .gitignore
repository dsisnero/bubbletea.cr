# Crystal API docs output (hand-written docs under docs/ are tracked)
/docs/*.html
/docs/css/
/docs/js/
/docs/api/
/lib/
/bin/
/.shards/
/.crystal-cache/
/temp/
*.dwarf

# Libraries don't need dependency lock
# Dependencies will be locked in applications that use them
/shard.lock
/skills/crystal-shard-lib-patch

# Dolt database files (added by bd init)
.dolt/
*.db
/vendor/temp
.claude/

# AppleDouble resource fork files (FAT32/exFAT removable drives)
._*

# npm tooling (tree-sitter parsers for local docs tooling)
/node_modules/
